From af787a31f2d498cb09067d2dfd7d2c81c4cbaacf Mon Sep 17 00:00:00 2001
From: Mason Chang <mason-cw.chang@mediatek.com>
Date: Thu, 10 Sep 2026 14:52:00 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: fix memory leak on page pool
 creation failure

If mtk_create_page_pool() fails, ring->data allocated via kcalloc()
was not freed before returning the error, causing a memory leak.
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -3180,8 +3180,11 @@ static int mtk_rx_alloc(struct mtk_eth *
 
 		pp = mtk_create_page_pool(eth, &ring->xdp_q, ring_no,
 					  rx_dma_size);
-		if (IS_ERR(pp))
+		if (IS_ERR(pp)) {
+			kfree(ring->data);
+			ring->data = NULL;
 			return PTR_ERR(pp);
+		}
 
 		ring->page_pool = pp;
 	} else if (mtk_page_pool_enabled(eth)) {
