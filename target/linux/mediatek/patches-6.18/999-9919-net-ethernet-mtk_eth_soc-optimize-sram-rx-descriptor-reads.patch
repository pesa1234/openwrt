Normal netsys v2 RX descriptors occupy 16 bytes in the Ethernet SRAM, but
mtk_rx_get_desc() reads them using four separate 32-bit accesses.  This is
particularly expensive on in-order Cortex-A53 CPUs.

Use two 64-bit MMIO accesses for SRAM-backed descriptors on 64-bit systems.
The first access obtains the stable buffer address and ownership
word; only read the remaining metadata after RX_DMA_DONE has been observed.
Keep the existing READ_ONCE() path for descriptors outside SRAM and for
32-bit systems.

The Ethernet SRAM is mapped write-combining (Normal-NC) by the mmio-sram
driver and the other descriptor rings come from dma_alloc_coherent(), so
the CPU may reorder the descriptor loads.  Add a dma_rmb() after the
RX_DMA_DONE check on both paths so that the metadata cannot be sampled
before the ownership word.

Netsys v3 only consumes rxd1 through rxd5 in the receive path, so stop
reading rxd6 and rxd7.  Its SRAM fast path consequently needs two 64-bit
accesses followed by one 32-bit access.

Signed-off-by: SmartWRT <smartwrt@localhost>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 50 ++++++++++++++++++++++++++++++++-----
 1 file changed, 44 insertions(+), 6 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1408,21 +1408,59 @@
 	return buf_size;
 }
 
+#ifdef CONFIG_64BIT
+static bool mtk_rx_get_desc_sram(struct mtk_eth *eth,
+				 struct mtk_rx_dma_v2 *rxd,
+				 struct mtk_rx_dma_v2 *dma_rxd)
+{
+	void __iomem *desc = (__force void __iomem *)dma_rxd;
+	u64 data;
+
+	/* SRAM allocations are 32-byte aligned and RX descriptors are at
+	 * least 16-byte aligned.  Read the stable buffer address together
+	 * with the ownership word, then fetch metadata only after the DMA
+	 * engine has released the descriptor.
+	 */
+	data = readq_relaxed(desc);
+	rxd->rxd2 = upper_32_bits(data);
+	if (!(rxd->rxd2 & RX_DMA_DONE))
+		return false;
+	rxd->rxd1 = lower_32_bits(data);
+
+	/* The SRAM is mapped write-combining (Normal-NC), so loads may be
+	 * reordered: do not sample the metadata before RX_DMA_DONE.
+	 */
+	dma_rmb();
+
+	data = readq_relaxed(desc + 8);
+	rxd->rxd3 = lower_32_bits(data);
+	rxd->rxd4 = upper_32_bits(data);
+	if (mtk_is_netsys_v3_or_greater(eth))
+		rxd->rxd5 = readl_relaxed(desc + 16);
+
+	return true;
+}
+#endif
+
 static bool mtk_rx_get_desc(struct mtk_eth *eth, struct mtk_rx_dma_v2 *rxd,
-			    struct mtk_rx_dma_v2 *dma_rxd)
+			    struct mtk_rx_dma_v2 *dma_rxd, bool in_sram)
 {
+#ifdef CONFIG_64BIT
+	if (in_sram)
+		return mtk_rx_get_desc_sram(eth, rxd, dma_rxd);
+#endif
+
 	rxd->rxd2 = READ_ONCE(dma_rxd->rxd2);
 	if (!(rxd->rxd2 & RX_DMA_DONE))
 		return false;
 
+	dma_rmb();
+
 	rxd->rxd1 = READ_ONCE(dma_rxd->rxd1);
 	rxd->rxd3 = READ_ONCE(dma_rxd->rxd3);
 	rxd->rxd4 = READ_ONCE(dma_rxd->rxd4);
-	if (mtk_is_netsys_v3_or_greater(eth)) {
+	if (mtk_is_netsys_v3_or_greater(eth))
 		rxd->rxd5 = READ_ONCE(dma_rxd->rxd5);
-		rxd->rxd6 = READ_ONCE(dma_rxd->rxd6);
-		rxd->rxd7 = READ_ONCE(dma_rxd->rxd7);
-	}
 
 	return true;
 }
@@ -2515,7 +2553,7 @@
 		rxd = ring->dma + RX_DESC_OFS(eth, idx);
 		data = ring->data[idx];
 
-		if (!mtk_rx_get_desc(eth, &trxd, rxd))
+		if (!mtk_rx_get_desc(eth, &trxd, rxd, ring->in_sram))
 			break;
 
 		/* find out which mac the packet come from. values start at 1 */
