+static void
+mt7915_mcu_update_survey_counter(struct mt7915_dev *dev, const char *name,
+				 u64 *counter, u64 cur, u64 prev,
+				 u64 max_delta)
+{
+	u64 delta = cur - prev;
+
+	if (delta <= max_delta) {
+		*counter += delta;
+		return;
+	}
+
+	dev_dbg_ratelimited(dev->mt76.dev,
+			    "ignore survey %s spike: delta=%llu max=%llu\n",
+			    name, (unsigned long long)delta,
+			    (unsigned long long)max_delta);
+}
