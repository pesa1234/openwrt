+static void
+mt7915_tm_txbf_remove_vif(struct mt7915_phy *phy)
+{
+	struct mt76_testmode_data *td = &phy->mt76->test;
+	struct ieee80211_vif *vif = td->second_vif;
+	struct mt7915_dev *dev = phy->dev;
+	struct mt7915_vif *mvif;
+	struct mt7915_sta *msta;
+
+	if (!vif)
+		return;
+
+	mvif = (struct mt7915_vif *)vif->drv_priv;
+	msta = &mvif->sta;
+
+	mt7915_mcu_add_bss_info(phy, vif, false);
+	mt7915_mcu_add_sta(dev, vif, NULL, CONN_STATE_DISCONNECT, false);
+	mt7915_mcu_add_dev_info(phy, vif, false);
+	rcu_assign_pointer(dev->mt76.wcid[msta->wcid.idx], NULL);
+
+	dev->mt76.vif_mask &= ~BIT_ULL(mvif->mt76.idx);
+	phy->omac_mask &= ~BIT_ULL(mvif->mt76.omac_idx);
+	mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta->wcid.idx);
+
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	if (!list_empty(&msta->wcid.poll_list))
+		list_del_init(&msta->wcid.poll_list);
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+
+	mt76_wcid_cleanup(&dev->mt76, &msta->wcid);
+	kfree(vif);
+	td->second_vif = NULL;
+}
