+void mt7915_mac_airtime_reset_work(struct work_struct *work)
+{
+	struct mt7915_dev *dev;
+	unsigned long idx;
+
+	dev = container_of(work, struct mt7915_dev, airtime_reset_work);
+
+	mutex_lock(&dev->mt76.mutex);
+	for_each_set_bit(idx, dev->airtime_reset, MT76_N_WCIDS) {
+		clear_bit(idx, dev->airtime_reset);
+
+		if (idx >= mt7915_wtbl_size(dev))
+			continue;
+
+		if (!mt7915_mac_wtbl_update(dev, idx,
+					      MT_WTBL_UPDATE_ADM_COUNT_CLEAR))
+			dev_dbg_ratelimited(dev->mt76.dev,
+					    "failed to reset airtime for WCID %lu\n",
+					    idx);
+	}
+	mutex_unlock(&dev->mt76.mutex);
+}
