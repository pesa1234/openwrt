Subject: [PATCH] wifi: mt76: mt7915: limit adjacent CAC experiment to MT7986

The reviewed mt_wifi source enables adjacent TX80/RX160 for MT7986 but
uses a different dedicated-ZW build path for MT7981. Do not advertise
or run the MT7986 experiment on MT7981 without separate analysis.

---
diff --git a/mt7915/main.c b/mt7915/main.c
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -2057,5 +2057,4 @@
 
-	if ((is_mt7981(&dev->mt76) || is_mt7986(&dev->mt76)) &&
-	    mt7915_adjacent_cac_enable) {
+	if (is_mt7986(&dev->mt76) && mt7915_adjacent_cac_enable) {
 		mutex_lock(&dev->mt76.mutex);
 
diff --git a/mt7915/init.c b/mt7915/init.c
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -450,4 +450,4 @@
 	if (mt7915_adjacent_cac_enable && phy->mt76->cap.has_5ghz &&
-	    (is_mt7981(&phy->dev->mt76) || is_mt7986(&phy->dev->mt76)))
+	    is_mt7986(&phy->dev->mt76))
 		wiphy_ext_feature_set(wiphy,
 				      NL80211_EXT_FEATURE_RADAR_BACKGROUND);
diff --git a/mt7915/mcu.c b/mt7915/mcu.c
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -368,5 +368,5 @@
 	/* A late event from the adjacent CAC is not radar on the lower AP. */
-	if ((is_mt7981(&dev->mt76) || is_mt7986(&dev->mt76)) &&
+	if (is_mt7986(&dev->mt76) &&
 	    r->rdd_idx != MT_RDD_IDX_BACKGROUND &&
 	    phy->mt76->dfs_state == MT_DFS_STATE_DISABLED)
 		return;
