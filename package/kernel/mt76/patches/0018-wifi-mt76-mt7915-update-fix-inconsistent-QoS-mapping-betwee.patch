From 605a40dad37c685a49f2c7985e3a05806d7ac1fc Mon Sep 17 00:00:00 2001
From: Benjamin Lin <benjamin-jw.lin@mediatek.com>
Date: Thu, 25 Apr 2024 17:17:13 +0800
Subject: [PATCH] wifi: mt76: mt7915: keep SW and HW QoS maps consistent

Pass customized DSCP mappings to hardware. Match the recommended map
used by cfg80211, commit the driver-private copy only after a successful
MCU command, and restore the default map after disabling customization.

Signed-off-by: Benjamin Lin <benjamin-jw.lin@mediatek.com>
---
 mt76_connac_mcu.h |  1 +
 mt7915/main.c     | 81 +++++++++++++++++++++++++++++++++++++++++++++++++++++-
 mt7915/mt7915.h   |  4 +++
 3 files changed, 86 insertions(+), 1 deletion(-)

--- a/mt76_connac_mcu.h
+++ b/mt76_connac_mcu.h
@@ -1274,6 +1274,7 @@ enum {
 	MCU_EXT_CMD_GROUP_PRE_CAL_INFO = 0xab,
 	MCU_EXT_CMD_DPD_PRE_CAL_INFO = 0xac,
 	MCU_EXT_CMD_PHY_STAT_INFO = 0xad,
+	MCU_EXT_CMD_SET_QOS_MAP = 0xb4,
 	MCU_EXT_CMD_WF_RF_PIN_CTRL = 0xbd,
 };
 
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -209,7 +209,7 @@ static int mt7915_add_interface(struct i
 	struct mt7915_phy *phy = mt7915_hw_phy(hw);
 	struct mt76_txq *mtxq;
 	bool ext_phy = phy != &dev->phy;
-	int idx, ret = 0;
+	int idx, i, ret = 0;
 
 	mutex_lock(&dev->mt76.mutex);
 
@@ -257,6 +257,20 @@ static int mt7915_add_interface(struct i
 	mvif->sta.wcid.tx_info |= MT_WCID_TX_INFO_SET;
 	mt76_wcid_init(&mvif->sta.wcid, phy->mt76->band_idx);
 
+	/* Default and recommended QoS map used by cfg80211_classify8021d(). */
+	for (i = 0; i < IP_DSCP_NUM; ++i)
+		mvif->qos_map[i] = i >> 3;
+
+	mvif->qos_map[10] = mvif->qos_map[12] =
+		mvif->qos_map[14] = mvif->qos_map[16] = 0;
+	mvif->qos_map[18] = mvif->qos_map[20] =
+		mvif->qos_map[22] = 3;
+	mvif->qos_map[24] = mvif->qos_map[26] =
+		mvif->qos_map[28] = mvif->qos_map[30] = 4;
+	mvif->qos_map[40] = 5;
+	mvif->qos_map[44] = mvif->qos_map[46] = 6;
+	mvif->qos_map[48] = 7;
+
 	mt7915_mac_wtbl_update(dev, idx,
 			       MT_WTBL_UPDATE_ADM_COUNT_CLEAR);
 
@@ -1742,6 +1756,71 @@ mt7915_set_frag_threshold(struct ieee802
 }
 
 static int
+mt7915_set_qos_map(struct ieee80211_vif *vif,
+			   struct cfg80211_qos_map *usr_qos_map)
+{
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	struct {
+		u8 bss_idx;
+		u8 qos_map_enable;
+		u8 __rsv[2];
+		u8 qos_map[IP_DSCP_NUM];
+	} __packed req = {
+		.bss_idx = mvif->mt76.idx,
+		.qos_map_enable = !!usr_qos_map,
+	};
+	int i, ret;
+
+	/* Prevent access to private VIF data before initialization. */
+	if (!mvif->phy)
+		return -EPERM;
+
+	/* Start from the same default and recommended mapping as cfg80211. */
+	for (i = 0; i < IP_DSCP_NUM; ++i)
+		req.qos_map[i] = i >> 3;
+
+	req.qos_map[10] = req.qos_map[12] =
+		req.qos_map[14] = req.qos_map[16] = 0;
+	req.qos_map[18] = req.qos_map[20] = req.qos_map[22] = 3;
+	req.qos_map[24] = req.qos_map[26] =
+		req.qos_map[28] = req.qos_map[30] = 4;
+	req.qos_map[40] = 5;
+	req.qos_map[44] = req.qos_map[46] = 6;
+	req.qos_map[48] = 7;
+
+	if (usr_qos_map) {
+		struct cfg80211_dscp_exception *exception =
+			usr_qos_map->dscp_exception;
+		struct cfg80211_dscp_range *range = usr_qos_map->up;
+
+		for (i = 0; i < IEEE80211_NUM_UPS; ++i) {
+			u8 low = range[i].low, high = range[i].high;
+
+			if (low < IP_DSCP_NUM && high < IP_DSCP_NUM &&
+			    low <= high)
+				memset(req.qos_map + low, i, high - low + 1);
+		}
+
+		for (i = 0; i < usr_qos_map->num_des; ++i) {
+			u8 dscp = exception[i].dscp, up = exception[i].up;
+
+			if (dscp < IP_DSCP_NUM && up < IEEE80211_NUM_UPS)
+				req.qos_map[dscp] = up;
+		}
+	}
+
+	ret = mt76_mcu_send_msg(&mvif->phy->dev->mt76,
+				MCU_WA_EXT_CMD(SET_QOS_MAP),
+				&req, sizeof(req), true);
+	if (ret)
+		return ret;
+
+	memcpy(mvif->qos_map, req.qos_map, IP_DSCP_NUM);
+
+	return 0;
+}
+
+static int
 mt7915_set_radar_background(struct ieee80211_hw *hw,
 			    struct cfg80211_chan_def *chandef)
 {
@@ -1887,6 +1966,7 @@ const struct ieee80211_ops mt7915_ops =
 	.add_twt_setup = mt7915_mac_add_twt_setup,
 	.twt_teardown_request = mt7915_twt_teardown_request,
 	.set_frag_threshold = mt7915_set_frag_threshold,
+	.set_qos_map = mt7915_set_qos_map,
 	CFG80211_TESTMODE_CMD(mt76_testmode_cmd)
 	CFG80211_TESTMODE_DUMP(mt76_testmode_dump)
 #ifdef CONFIG_MAC80211_DEBUGFS
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -86,6 +86,8 @@
 
 #define MT7915_RTS_LEN_THRES		0x92b
 
+#define IP_DSCP_NUM			64
+
 struct mt7915_vif;
 struct mt7915_sta;
 struct mt7915_dfs_pulse;
@@ -177,6 +179,8 @@ struct mt7915_vif {
 
 	struct ieee80211_tx_queue_params queue_params[IEEE80211_NUM_ACS];
 	struct cfg80211_bitrate_mask bitrate_mask;
+	/* QoS map support */
+	u8 qos_map[IP_DSCP_NUM];
 };
 
 /* crash-dump */
