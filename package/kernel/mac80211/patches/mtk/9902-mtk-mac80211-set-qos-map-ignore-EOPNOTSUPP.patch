From: SmartWRT <support@smartwrt.example>
Subject: [PATCH] mac80211: make QoS map updates atomic and propagate to AP VLANs

Keep the software QoS map unchanged when the driver rejects an update, and
make AP VLAN interfaces follow their parent AP.  Drivers which do not
implement set_qos_map still use the mac80211 software mapping.

---
 net/mac80211/cfg.c | 101 ++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 87 insertions(+), 14 deletions(-)

--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -5125,27 +5125,100 @@ static void ieee80211_set_wakeup(struct
 }
 #endif
 
+struct ieee80211_qos_map_update {
+	struct list_head list;
+	struct ieee80211_sub_if_data *sdata;
+	struct mac80211_qos_map *new_qos_map;
+};
+
+static int
+ieee80211_prepare_qos_map_update(struct list_head *updates,
+				 struct ieee80211_sub_if_data *sdata,
+				 const struct cfg80211_qos_map *qos_map)
+{
+	struct ieee80211_qos_map_update *update;
+
+	update = kzalloc_obj(*update);
+	if (!update)
+		return -ENOMEM;
+
+	if (qos_map) {
+		update->new_qos_map = kzalloc_obj(*update->new_qos_map);
+		if (!update->new_qos_map) {
+			kfree(update);
+			return -ENOMEM;
+		}
+
+		update->new_qos_map->qos_map = *qos_map;
+	}
+
+	update->sdata = sdata;
+	list_add_tail(&update->list, updates);
+
+	return 0;
+}
+
 static int ieee80211_set_qos_map(struct wiphy *wiphy,
 				 struct net_device *dev,
 				 struct cfg80211_qos_map *qos_map)
 {
 	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
-	struct mac80211_qos_map *new_qos_map, *old_qos_map;
+	struct ieee80211_qos_map_update *update, *tmp;
+	struct ieee80211_sub_if_data *vlan;
+	LIST_HEAD(updates);
+	int ret;
 
-	if (qos_map) {
-		new_qos_map = kzalloc_obj(*new_qos_map);
-		if (!new_qos_map)
-			return -ENOMEM;
-		memcpy(&new_qos_map->qos_map, qos_map, sizeof(*qos_map));
-	} else {
-		/* A NULL qos_map was passed to disable QoS mapping */
-		new_qos_map = NULL;
+	lockdep_assert_wiphy(wiphy);
+
+	/* AP VLANs use the queues and driver vif of their parent AP. */
+	if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN) {
+		if (!sdata->bss)
+			return -ENOLINK;
+
+		sdata = container_of(sdata->bss,
+				     struct ieee80211_sub_if_data, u.ap);
 	}
 
-	old_qos_map = sdata_dereference(sdata->qos_map, sdata);
-	rcu_assign_pointer(sdata->qos_map, new_qos_map);
-	if (old_qos_map)
-		kfree_rcu(old_qos_map, rcu_head);
+	ret = ieee80211_prepare_qos_map_update(&updates, sdata, qos_map);
+	if (ret)
+		goto free_updates;
+
+	if (sdata->vif.type == NL80211_IFTYPE_AP)
+		list_for_each_entry(vlan, &sdata->u.ap.vlans, u.vlan.list) {
+			ret = ieee80211_prepare_qos_map_update(&updates, vlan,
+							       qos_map);
+			if (ret)
+				goto free_updates;
+		}
+
+	ret = drv_set_qos_map(sdata->local, sdata, qos_map);
+	if (ret == -EOPNOTSUPP)
+		ret = 0;
+	if (ret)
+		goto free_updates;
+
+	list_for_each_entry_safe(update, tmp, &updates, list) {
+		struct mac80211_qos_map *old_qos_map;
+
+		old_qos_map = sdata_dereference(update->sdata->qos_map,
+						 update->sdata);
+		rcu_assign_pointer(update->sdata->qos_map,
+				   update->new_qos_map);
+		if (old_qos_map)
+			kfree_rcu(old_qos_map, rcu_head);
+
+		list_del(&update->list);
+		kfree(update);
+	}
+
+	return 0;
 
-	return drv_set_qos_map(sdata->local, sdata, qos_map);
+free_updates:
+	list_for_each_entry_safe(update, tmp, &updates, list) {
+		kfree(update->new_qos_map);
+		list_del(&update->list);
+		kfree(update);
+	}
+
+	return ret;
 }
