From 9cc3b09943ebc5b3c5a1c5256d4fd84cf9388519 Mon Sep 17 00:00:00 2001
From: "Allen.Ye" <allen.ye@mediatek.com>
Date: Thu, 9 Nov 2023 11:37:37 +0800
Subject: [PATCH 32/87] mtk: mac80211: Add cert mode to disable BA timeout

Add a certification mode switch in debugfs. The mode can only be
changed while all interfaces are down, so every BA session observes one
stable setting for its entire lifetime. Use READ_ONCE/WRITE_ONCE because
the value is also consumed from TX paths outside the wiphy lock.

Signed-off-by: Allen.Ye <allen.ye@mediatek.com>
Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
---
 include/net/mac80211.h |  6 ++++++
 net/mac80211/agg-tx.c  |  5 ++++-
 net/mac80211/debugfs.c | 60 ++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 70 insertions(+), 1 deletion(-)

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -3121,8 +3121,14 @@ struct ieee80211_hw {
 	u32 max_mtu;
 	const s8 *tx_power_levels;
 	u8 max_txpwr_levels_idx;
+	bool cert_mode;
 };
 
+static inline bool ieee80211_is_cert_mode(struct ieee80211_hw *hw)
+{
+	return READ_ONCE(hw->cert_mode);
+}
+
 static inline bool _ieee80211_hw_check(struct ieee80211_hw *hw,
 				       enum ieee80211_hw_flags flg)
 {
--- a/net/mac80211/agg-tx.c
+++ b/net/mac80211/agg-tx.c
@@ -1050,7 +1050,10 @@ void ieee80211_process_addba_resp(struct
 		tid_tx->timeout =
 			le16_to_cpu(mgmt->u.action.u.addba_resp.timeout);
 
-		if (tid_tx->timeout) {
+		/* Certification peers may not tolerate periodic DELBA frames,
+		 * therefore leave accepted sessions without a session timer.
+		 */
+		if (tid_tx->timeout && !ieee80211_is_cert_mode(&local->hw)) {
 			mod_timer(&tid_tx->session_timer,
 				  TU_TO_EXP_TIME(tid_tx->timeout));
 			tid_tx->last_tx = jiffies;
--- a/net/mac80211/debugfs.c
+++ b/net/mac80211/debugfs.c
@@ -444,6 +444,63 @@ static const struct file_operations rese
 };
 #endif
 
+static ssize_t cert_mode_read(struct file *file,
+			      char __user *user_buf,
+			      size_t count,
+			      loff_t *ppos)
+{
+	struct ieee80211_local *local = file->private_data;
+	char buf[32];
+	int len;
+
+	len = scnprintf(buf, sizeof(buf), "cert_mode: %d\n",
+			READ_ONCE(local->hw.cert_mode));
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t cert_mode_write(struct file *file,
+			       const char __user *user_buf,
+			       size_t count,
+			       loff_t *ppos)
+{
+	struct ieee80211_local *local = file->private_data;
+	bool cert_mode;
+	char buf[16];
+	int ret = 0;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+
+	if (count && buf[count - 1] == '\n')
+		buf[count - 1] = '\0';
+	else
+		buf[count] = '\0';
+
+	if (kstrtobool(buf, &cert_mode))
+		return -EINVAL;
+
+	/* Avoid changing policy underneath already negotiated BA sessions. */
+	wiphy_lock(local->hw.wiphy);
+	if (local->open_count)
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(local->hw.cert_mode, cert_mode);
+	wiphy_unlock(local->hw.wiphy);
+
+	return ret ?: count;
+}
+
+static const struct file_operations cert_mode_ops = {
+	.write = cert_mode_write,
+	.read = cert_mode_read,
+	.open = simple_open,
+	.llseek = noop_llseek,
+};
+
 static const char *hw_flag_names[] = {
 #define FLAG(F)	[IEEE80211_HW_##F] = #F
 	FLAG(HAS_RATE_CONTROL),
@@ -717,6 +774,7 @@ void debugfs_hw_add(struct ieee80211_loc
 	debugfs_create_u32("aql_threshold", 0600,
 			   phyd, &local->aql_threshold);
 
+	DEBUGFS_ADD_MODE(cert_mode, 0644);
 	statsd = debugfs_create_dir("statistics", phyd);
 
 #ifdef CPTCFG_MAC80211_DEBUG_COUNTERS
