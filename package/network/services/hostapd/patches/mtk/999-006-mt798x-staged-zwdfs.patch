+		iface->radar_background.cac_started = 0;
+		iface->radar_background.temp_ch = 0;
+		return 0;
+	}
+
 	if (!dfs_use_radar_background(iface))
 		return -1; /* Background radar chain not supported. */
 
@@ -1533,11 +1722,26 @@ static int hostapd_dfs_start_channel_switch(struct hostapd_iface *iface)
 	if (iface->cac_started)
 		return hostapd_dfs_start_channel_switch_cac(iface);
 
+	/* The original lower 80 MHz block never required CAC. Returning to
+	 * it after radar on the 160 MHz operating channel avoids a new CAC. */
+	if (dfs_use_staged_zwdfs(iface) &&
+	    hostapd_get_oper_chwidth(iface->conf) ==
+		CONF_OPER_CHWIDTH_160MHZ &&
+	    hostapd_get_oper_centr_freq_seg0_idx(iface->conf) == 50)
+		return hostapd_dfs_request_channel_switch(
+			iface, 36, 5180, 1, current_vht_oper_chwidth,
+			CONF_OPER_CHWIDTH_80MHZ, 42, 0);
+
 	/*
 	 * Allow selection of DFS channel in ETSI to comply with
 	 * uniform spreading.
 	 */
-	if (iface->dfs_domain == HOSTAPD_DFS_REGION_ETSI)
+	if (iface->dfs_domain == HOSTAPD_DFS_REGION_ETSI &&
+	    !(dfs_use_staged_zwdfs(iface) &&
+	      iface->conf->channel >= 52 && iface->conf->channel <= 64 &&
+	      hostapd_get_oper_chwidth(iface->conf) ==
+		CONF_OPER_CHWIDTH_80MHZ &&
+	      hostapd_get_oper_centr_freq_seg0_idx(iface->conf) == 58))
 		channel_type = DFS_ANY_CHANNEL;
 
 	/* Perform channel switch/CSA */
@@ -1586,6 +1790,7 @@ static int hostapd_dfs_start_channel_switch(struct hostapd_iface *iface)
 						  channel->freq,
 						  secondary_channel,
 						  current_vht_oper_chwidth,
+						  hostapd_get_oper_chwidth(iface->conf),
 						  oper_centr_freq_seg0_idx,
 						  oper_centr_freq_seg1_idx);
 }
@@ -1665,6 +1870,9 @@ int hostapd_dfs_nop_finished(struct hostapd_iface *iface, int freq,
 	set_dfs_state(iface, freq, ht_enabled, chan_offset, chan_width,
 		      cf1, cf2, HOSTAPD_CHAN_DFS_USABLE);
 
+	if (dfs_use_staged_zwdfs(iface))
+		hostapd_dfs_start_staged_cac(iface);
+
 	if (iface->state == HAPD_IFACE_DFS && !iface->cac_started) {
 		/* Handle cases where all channels were initially unavailable */
 		hostapd_handle_dfs(iface);
@@ -1747,6 +1955,10 @@ int hostapd_dfs_start_cac(struct hostapd_data *hapd, int freq,
 	}
 	/* TODO: How to check CAC time for ETSI weather channels? */
 	iface->dfs_cac_ms = 60000;
+	if (dfs_use_staged_zwdfs(iface) &&
+	    iface->dfs_domain == HOSTAPD_DFS_REGION_ETSI &&
+	    (hostapd_dfs_is_background_event(iface, freq) || offchannel_cac))
+		iface->dfs_cac_ms = 360000;
 	wpa_msg(hapd->msg_ctx, MSG_INFO, DFS_EVENT_CAC_START
 		"freq=%d chan=%d chan_offset=%d width=%d seg0=%d "
 		"seg1=%d cac_time=%ds%s",
