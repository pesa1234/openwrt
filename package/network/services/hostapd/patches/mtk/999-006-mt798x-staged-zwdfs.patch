index 87872e5..805c1c4 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3437,6 +3437,12 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 		conf->acs_exclude_6ghz_non_psc = atoi(pos);
 	} else if (os_strcmp(buf, "enable_background_radar") == 0) {
 		conf->enable_background_radar = atoi(pos);
+	} else if (os_strcmp(buf, "enable_staged_zwdfs") == 0) {
+		conf->enable_staged_zwdfs = atoi(pos) == 1;
+	} else if (os_strcmp(buf, "staged_zwdfs_channel") == 0) {
+		conf->staged_zwdfs_channel = atoi(pos);
+	} else if (os_strcmp(buf, "staged_zwdfs_width") == 0) {
+		conf->staged_zwdfs_width = atoi(pos) == 160 ? 160 : 0;
 	} else if (os_strcmp(buf, "min_tx_power") == 0) {
 		int val = atoi(pos);
 
