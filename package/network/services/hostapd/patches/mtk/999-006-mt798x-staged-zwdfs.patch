 		iface->radar_background.freq == freq;
 }
 
@@ -1231,12 +1358,60 @@ static int
 hostapd_dfs_start_channel_switch_background(struct hostapd_iface *iface)
 {
 	u8 current_vht_oper_chwidth = hostapd_get_oper_chwidth(iface->conf);
+	int final_channel = iface->conf->staged_zwdfs_channel;
+	int secondary_channel;
+	int i;
 	int ret;
 
+	if (dfs_use_staged_zwdfs(iface)) {
+		if (iface->state != HAPD_IFACE_ENABLED ||
+		    iface->conf->channel != 36 ||
+		    hostapd_get_oper_chwidth(iface->conf) !=
+			CONF_OPER_CHWIDTH_80MHZ ||
+		    hostapd_get_oper_centr_freq_seg0_idx(iface->conf) != 42) {
+			iface->radar_background.channel = -1;
+			return 0;
+		}
+		if (iface->conf->staged_zwdfs_width == 160) {
+			if (!final_channel)
+				final_channel = 36;
+			if (final_channel < 36 || final_channel > 64 ||
+			    (final_channel - 36) % 4) {
+				iface->radar_background.channel = -1;
+				return -1;
+			}
+			secondary_channel = ((final_channel - 36) / 4) % 2 ? -1 : 1;
+			for (i = 0; i < iface->current_mode->num_channels; i++)
+				if (iface->current_mode->channels[i].chan == 52)
+					break;
+			if (i == iface->current_mode->num_channels ||
+			    !dfs_chan_range_available(iface->current_mode, i, 4,
+						      DFS_AVAILABLE)) {
+				iface->radar_background.channel = -1;
+				return -1;
+			}
+			ret = hostapd_dfs_request_channel_switch(
+				iface, final_channel, 5000 + 5 * final_channel,
+				secondary_channel, current_vht_oper_chwidth,
+				CONF_OPER_CHWIDTH_160MHZ, 50, 0);
+			iface->radar_background.channel = -1;
+			return ret;
+		}
+		ret = hostapd_dfs_request_channel_switch(
+			iface, iface->radar_background.channel,
+			iface->radar_background.freq,
+			iface->radar_background.secondary_channel,
+			current_vht_oper_chwidth,
+			current_vht_oper_chwidth, 58, 0);
+		iface->radar_background.channel = -1;
+		return ret;
+	}
+
 	ret = hostapd_dfs_request_channel_switch(iface, iface->radar_background.channel,
 						 iface->radar_background.freq,
 						 iface->radar_background.secondary_channel,
 						 current_vht_oper_chwidth,
+						 hostapd_get_oper_chwidth(iface->conf),
 						 iface->radar_background.centr_freq_seg0_idx,
 						 iface->radar_background.centr_freq_seg1_idx);
 
@@ -1335,7 +1510,12 @@ int hostapd_dfs_complete_cac(struct hostapd_iface *iface, int success, int freq,
 		}
 	} else if (hostapd_dfs_is_background_event(iface, freq)) {
 		iface->radar_background.cac_started = 0;
-		hostapd_dfs_update_background_chain(iface);
+		if (dfs_use_staged_zwdfs(iface)) {
+			iface->radar_background.channel = -1;
+			iface->radar_background.temp_ch = 0;
+		} else {
+			hostapd_dfs_update_background_chain(iface);
+		}
 	}
 
 	iface->radar_detected = false;
@@ -1469,6 +1649,15 @@ static int
 hostapd_dfs_background_start_channel_switch(struct hostapd_iface *iface,
 					    int freq)
 {
