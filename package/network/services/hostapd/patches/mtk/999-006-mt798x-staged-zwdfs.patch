+	    iface->conf->channel == 36) {
+		csa_settings.cs_count = 10;
+		csa_settings.block_tx = 0;
+	}
 	csa_settings.link_id = -1;
 #ifdef CONFIG_IEEE80211BE
 	if (iface->bss[0]->conf->mld_ap)
@@ -1102,6 +1217,10 @@ static int hostapd_dfs_request_channel_switch(struct hostapd_iface *iface,
 	if (err) {
 		wpa_printf(MSG_ERROR,
 			   "DFS failed to calculate CSA freq params");
+		if (staged_expand) {
+			iface->conf->op_class = old_op_class;
