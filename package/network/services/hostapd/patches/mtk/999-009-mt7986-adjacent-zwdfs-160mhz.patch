From: SmartWRT
Subject: [PATCH] hostapd: stage MT7986 160 MHz AP on lower 80 MHz block

Mirror the MT7986 TX80/RX160 sequence: transmit on 36-48 at 80 MHz,
check 52-64 with the adjacent receiver, then expand to 160 MHz with a
CSA only after successful CAC. Preserve the requested 160 MHz primary.
On radar while operating at 160 MHz, return to the lower non-DFS 80 MHz
block without starting another main-chain CAC. Keep this opt-in and
limited to the 36-64 block.

--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1128,3 +1128,4 @@
 	int enable_adjacent_zwdfs;
 	int adjacent_zwdfs_channel;
+	int adjacent_zwdfs_width;
 	enum {
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3440,5 +3440,7 @@
 		conf->enable_adjacent_zwdfs = atoi(pos) == 1;
 	} else if (os_strcmp(buf, "adjacent_zwdfs_channel") == 0) {
 		conf->adjacent_zwdfs_channel = atoi(pos);
+	} else if (os_strcmp(buf, "adjacent_zwdfs_width") == 0) {
+		conf->adjacent_zwdfs_width = atoi(pos) == 160 ? 160 : 0;
 	} else if (os_strcmp(buf, "min_tx_power") == 0) {
 		int val = atoi(pos);
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -332,6 +332,7 @@
 	struct hostapd_channel_data *chan;
 	struct hostapd_channel_data *target_chan = NULL;
 	int target = iface->conf->adjacent_zwdfs_channel;
+	int final_channel = target;
 	int secondary_channel;
 	int i;
 
@@ -336,6 +337,10 @@
 
 	if (!target)
 		target = 52;
+	/* At 160 MHz, the lower 80 MHz primary still needs upper-half CAC. */
+	if (iface->conf->adjacent_zwdfs_width == 160 &&
+	    final_channel >= 36 && final_channel <= 48)
+		target = 52;
 	if (target != 52 && target != 56 && target != 60 && target != 64)
 		return;
 	secondary_channel = (target == 56 || target == 64) ? -1 : 1;
@@ -1120,16 +1125,21 @@
 static int hostapd_dfs_request_channel_switch(struct hostapd_iface *iface,
 					      int channel, int freq,
 					      int secondary_channel,
 					      u8 current_vht_oper_chwidth,
+					      u8 new_vht_oper_chwidth,
 					      u8 oper_centr_freq_seg0_idx,
 					      u8 oper_centr_freq_seg1_idx)
 {
 	struct hostapd_hw_modes *cmode = iface->current_mode;
 	int ieee80211_mode = IEEE80211_MODE_AP, err;
 	struct csa_settings csa_settings;
-	u8 new_vht_oper_chwidth;
 	unsigned int i;
 	unsigned int num_err = 0;
 	u8 op_class, chan;
+	u8 old_op_class = iface->conf->op_class;
+	bool adjacent_expand = dfs_use_adjacent_zwdfs(iface) &&
+		current_vht_oper_chwidth == CONF_OPER_CHWIDTH_80MHZ &&
+		new_vht_oper_chwidth == CONF_OPER_CHWIDTH_160MHZ &&
+		iface->conf->channel == 36;
 
 	wpa_printf(MSG_DEBUG, "DFS will switch to a new channel %d", channel);
@@ -1140,1 +1148,0 @@
-	new_vht_oper_chwidth = hostapd_get_oper_chwidth(iface->conf);
@@ -1189,6 +1196,10 @@
 	if (err) {
 		wpa_printf(MSG_ERROR,
 			   "DFS failed to calculate CSA freq params");
+		if (adjacent_expand) {
+			iface->conf->op_class = old_op_class;
+			return err;
+		}
 		hostapd_disable_iface(iface);
 		return err;
 	}
@@ -1201,6 +1212,13 @@
 	}
 
 	if (num_err == iface->num_bss) {
+		/* A failed optional 80->160 expansion must leave the AP up. */
+		if (adjacent_expand) {
+			wpa_printf(MSG_WARNING,
+				   "Adjacent ZWDFS: 160 MHz CSA failed; retaining 80 MHz AP");
+			iface->conf->op_class = old_op_class;
+			return -1;
+		}
 		wpa_printf(MSG_WARNING,
 			   "DFS failed to schedule CSA (%d) - trying fallback",
 			   err);
@@ -1321,5 +1339,7 @@
 {
 	u8 current_vht_oper_chwidth = hostapd_get_oper_chwidth(iface->conf);
+	int final_channel = iface->conf->adjacent_zwdfs_channel;
+	int secondary_channel;
 	int ret;
 
 	if (dfs_use_adjacent_zwdfs(iface)) {
@@ -1330,11 +1350,28 @@
 			iface->radar_background.channel = -1;
 			return 0;
 		}
+		if (iface->conf->adjacent_zwdfs_width == 160) {
+			if (!final_channel)
+				final_channel = 36;
+			if (final_channel < 36 || final_channel > 64 ||
+			    (final_channel - 36) % 4) {
+				iface->radar_background.channel = -1;
+				return -1;
+			}
+			secondary_channel = ((final_channel - 36) / 4) % 2 ? -1 : 1;
+			ret = hostapd_dfs_request_channel_switch(
+				iface, final_channel, 5000 + 5 * final_channel,
+				secondary_channel, current_vht_oper_chwidth,
+				CONF_OPER_CHWIDTH_160MHZ, 50, 0);
+			iface->radar_background.channel = -1;
+			return ret;
+		}
 		ret = hostapd_dfs_request_channel_switch(
 			iface, iface->radar_background.channel,
 			iface->radar_background.freq,
 			iface->radar_background.secondary_channel,
-			current_vht_oper_chwidth, 58, 0);
+			current_vht_oper_chwidth,
+			current_vht_oper_chwidth, 58, 0);
 		iface->radar_background.channel = -1;
 		return ret;
 	}
@@ -1342,6 +1381,7 @@
 	ret = hostapd_dfs_request_channel_switch(iface, iface->radar_background.channel,
 						 iface->radar_background.freq,
 						 iface->radar_background.secondary_channel,
 						 current_vht_oper_chwidth,
+						 hostapd_get_oper_chwidth(iface->conf),
 						 iface->radar_background.centr_freq_seg0_idx,
 						 iface->radar_background.centr_freq_seg1_idx);
@@ -1654,5 +1694,15 @@
 	if (iface->cac_started)
 		return hostapd_dfs_start_channel_switch_cac(iface);
 
+	/* The original lower 80 MHz block never required CAC. Returning to
+	 * it after radar on the 160 MHz operating channel avoids a new CAC. */
+	if (dfs_use_adjacent_zwdfs(iface) &&
+	    hostapd_get_oper_chwidth(iface->conf) ==
+		CONF_OPER_CHWIDTH_160MHZ &&
+	    hostapd_get_oper_centr_freq_seg0_idx(iface->conf) == 50)
+		return hostapd_dfs_request_channel_switch(
+			iface, 36, 5180, 1, current_vht_oper_chwidth,
+			CONF_OPER_CHWIDTH_80MHZ, 42, 0);
+
 	/*
 	 * Allow selection of DFS channel in ETSI to comply with
@@ -1710,6 +1760,7 @@
 	return hostapd_dfs_request_channel_switch(iface, channel->chan,
 						  channel->freq,
 						  secondary_channel,
 						  current_vht_oper_chwidth,
+						  hostapd_get_oper_chwidth(iface->conf),
 						  oper_centr_freq_seg0_idx,
 						  oper_centr_freq_seg1_idx);
