From: SmartWRT
Subject: [PATCH] hostapd: use configured primary in MT7986 adjacent DFS block

The MT7986 vendor driver records the requested OutBandCh (52/56/60/64)
while temporarily serving on the lower 80 MHz block. Do the same for an
explicitly configured DFS primary, retaining 52 as the legacy prototype
default when the AP is configured on 36. The adjacent hardware can only
check the 52-64 block while transmitting on the 36-48 block.

--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1128,1 +1128,2 @@
-	int enable_adjacent_zwdfs;
+	int enable_adjacent_zwdfs;
+	int adjacent_zwdfs_channel;
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3438,5 +3438,7 @@
 		conf->enable_background_radar = atoi(pos);
 	} else if (os_strcmp(buf, "enable_adjacent_zwdfs") == 0) {
 		conf->enable_adjacent_zwdfs = atoi(pos) == 1;
+	} else if (os_strcmp(buf, "adjacent_zwdfs_channel") == 0) {
+		conf->adjacent_zwdfs_channel = atoi(pos);
 	} else if (os_strcmp(buf, "min_tx_power") == 0) {
 		int val = atoi(pos);
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -330,47 +330,67 @@
 {
 	struct hostapd_hw_modes *mode;
 	struct hostapd_channel_data *chan;
+	struct hostapd_channel_data *target_chan = NULL;
+	int target = iface->conf->adjacent_zwdfs_channel;
+	int secondary_channel;
 	int i;
 
+	if (!target)
+		target = 52;
+	if (target != 52 && target != 56 && target != 60 && target != 64)
+		return;
+	secondary_channel = (target == 56 || target == 64) ? -1 : 1;
+
 	/* The MT7986 prototype can only monitor 52-64 while TX stays on 36-48. */
 	if (!dfs_use_adjacent_zwdfs(iface) ||
 	    iface->state != HAPD_IFACE_ENABLED ||
 	    iface->conf->channel != 36 ||
 	    hostapd_get_oper_chwidth(iface->conf) != CONF_OPER_CHWIDTH_80MHZ ||
 	    hostapd_get_oper_centr_freq_seg0_idx(iface->conf) != 42 ||
-	    iface->radar_background.channel == 52)
+	    iface->radar_background.channel > 0)
 		return;
 
 	mode = iface->current_mode;
+	for (i = 0; i < mode->num_channels; i++) {
+		if (mode->channels[i].chan == target) {
+			target_chan = &mode->channels[i];
+			break;
+		}
+	}
+	if (!target_chan || !is_in_chanlist(iface, target_chan) ||
+	    !chan_pri_allowed(target_chan))
+		return;
+
 	for (i = 0; i < mode->num_channels; i++) {
 		chan = &mode->channels[i];
-		if (chan->chan != 52 || !is_in_chanlist(iface, chan) ||
+		if (chan->chan != 52 ||
 		    !dfs_chan_range_available(mode, i, 4, DFS_NO_CAC_YET))
 			continue;
 
-		iface->radar_background.channel = 52;
-		iface->radar_background.freq = 5260;
-		iface->radar_background.secondary_channel = 1;
+		iface->radar_background.channel = target;
+		iface->radar_background.freq = target_chan->freq;
+		iface->radar_background.secondary_channel = secondary_channel;
 		iface->radar_background.centr_freq_seg0_idx = 58;
 		iface->radar_background.centr_freq_seg1_idx = 0;
 		iface->radar_background.cac_started = 1;
 		iface->radar_background.temp_ch = 1;
 		if (hostapd_start_dfs_cac(iface, iface->conf->hw_mode,
-					  5260, 52, iface->conf->ieee80211n,
+					  target_chan->freq, target,
+					  iface->conf->ieee80211n,
 					  iface->conf->ieee80211ac,
 					  iface->conf->ieee80211ax,
 					  iface->conf->ieee80211be,
-					  1, CONF_OPER_CHWIDTH_80MHZ,
+					  secondary_channel, CONF_OPER_CHWIDTH_80MHZ,
 					  58, 0, true)) {
 			wpa_printf(MSG_WARNING,
-				   "Adjacent ZWDFS: failed to start CAC on channel 52");
+				   "Adjacent ZWDFS: failed to start CAC on channel %d", target);
 			iface->radar_background.channel = -1;
 			iface->radar_background.cac_started = 0;
 			iface->radar_background.temp_ch = 0;
 		} else {
 			wpa_printf(MSG_INFO,
-				   "Adjacent ZWDFS: checking channel 52 while AP stays on 36");
+				   "Adjacent ZWDFS: checking channel %d while AP stays on 36", target);
 		}
 		return;
 	}
 }
@@ -1131,7 +1150,9 @@
 	csa_settings.cs_count = 5;
 	csa_settings.block_tx = 1;
-	/* No radar was seen on the non-DFS AP when entering pre-cleared 52. */
-	if (dfs_use_adjacent_zwdfs(iface) && channel == 52 &&
+	/* No radar was seen on the non-DFS AP when entering the cleared block. */
+	if (dfs_use_adjacent_zwdfs(iface) &&
+	    channel == (iface->conf->adjacent_zwdfs_channel ?
+		iface->conf->adjacent_zwdfs_channel : 52) &&
 	    iface->conf->channel == 36) {
 		csa_settings.cs_count = 10;
 		csa_settings.block_tx = 0;
@@ -1308,6 +1328,9 @@
 			return 0;
 		}
-		ret = hostapd_dfs_request_channel_switch(iface, 52, 5260, 1,
-						 current_vht_oper_chwidth, 58, 0);
+		ret = hostapd_dfs_request_channel_switch(
+			iface, iface->radar_background.channel,
+			iface->radar_background.freq,
+			iface->radar_background.secondary_channel,
+			current_vht_oper_chwidth, 58, 0);
 		iface->radar_background.channel = -1;
 		return ret;
@@ -1633,6 +1657,6 @@
 	 */
 	if (iface->dfs_domain == HOSTAPD_DFS_REGION_ETSI &&
 	    !(dfs_use_adjacent_zwdfs(iface) &&
-	      iface->conf->channel == 52 &&
+	      iface->conf->channel >= 52 && iface->conf->channel <= 64 &&
 	      hostapd_get_oper_chwidth(iface->conf) ==
 		CONF_OPER_CHWIDTH_80MHZ &&
