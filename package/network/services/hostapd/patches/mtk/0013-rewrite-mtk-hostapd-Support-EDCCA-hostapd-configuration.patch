 #endif /* CONFIG_TESTING_OPTIONS */
 
 
+static int hostapd_ctrl_iface_parse_edcca_int(const char *value, int min,
+					       int max, int *result)
+{
+	const char *pos = value;
+	char *end;
+	long parsed;
+
+	while (*pos == ' ' || *pos == '\t')
+		pos++;
+	parsed = strtol(pos, &end, 10);
+	if (end == pos)
+		return -1;
+	while (*end == ' ' || *end == '\t')
+		end++;
+	if (*end || parsed < min || parsed > max)
+		return -1;
+
+	*result = parsed;
+	return 0;
+}
+
+
+static int
+hostapd_ctrl_iface_set_edcca(struct hostapd_data *hapd, char *cmd,
+			     char *buf, size_t buflen)
+{
+	char *pos, *config, *value;
+
+	config = cmd;
+	pos = os_strchr(config, ' ');
+	if (!pos)
+		return -1;
+	*pos++ = '\0';
+	if (!*pos)
+		return -1;
+	value = pos;
+
+	if (os_strcmp(config, "enable") == 0) {
+		u8 old_mode = hapd->iconf->edcca_enable;
+		int mode;
+
+		if (hostapd_ctrl_iface_parse_edcca_int(
+			    value, EDCCA_MODE_FORCE_DISABLE, EDCCA_MODE_AUTO,
+			    &mode)) {
+			wpa_printf(MSG_ERROR, "Invalid value for edcca enable");
+			return -1;
+		}
+		hapd->iconf->edcca_enable = (u8) mode;
+		if (hostapd_drv_configure_edcca_enable(hapd) != 0) {
+			hapd->iconf->edcca_enable = old_mode;
+			return -1;
+		}
+	} else if (os_strcmp(config, "compensation") == 0) {
+		s8 old_compensation = hapd->iconf->edcca_compensation;
+		int compensation;
+
+		if (hostapd_ctrl_iface_parse_edcca_int(
+			    value, EDCCA_MIN_COMPENSATION,
+			    EDCCA_MAX_COMPENSATION, &compensation)) {
+			wpa_printf(MSG_ERROR, "Invalid value for edcca compensation");
+			return -1;
+		}
+		hapd->iconf->edcca_compensation = (s8) compensation;
+		if (hostapd_drv_configure_edcca_enable(hapd) != 0) {
+			hapd->iconf->edcca_compensation = old_compensation;
+			return -1;
+		}
+	} else if (os_strcmp(config, "threshold") == 0) {
+		char *thres_value;
+		int bw_idx, threshold;
+		int threshold_arr[EDCCA_MAX_BW_NUM];
+		size_t i;
+
+		thres_value = os_strchr(value, ':');
+		if (!thres_value)
+			return -1;
+		*thres_value++ = '\0';
+		if (hostapd_ctrl_iface_parse_edcca_int(
+			    value, EDCCA_BW_20, EDCCA_BW_160, &bw_idx)) {
+			wpa_printf(MSG_ERROR,
+				   "Invalid bandwidth index for SET_EDCCA");
+			return -1;
+		}
+		if (hostapd_ctrl_iface_parse_edcca_int(
+			    thres_value, EDCCA_MIN_CONFIG_THRES,
+			    EDCCA_MAX_CONFIG_THRES, &threshold)) {
+			wpa_printf(MSG_ERROR,
+				   "Invalid threshold for SET_EDCCA");
+			return -1;
+		}
+
+		/* 0x7f tells the firmware to preserve the current value. */
+		for (i = 0; i < EDCCA_MAX_BW_NUM; i++)
+			threshold_arr[i] = 0x7f;
+		threshold_arr[bw_idx] = threshold;
+
+		if (hostapd_drv_configure_edcca_threshold(
+			    hapd, threshold_arr) != 0)
+			return -1;
+	} else {
+		wpa_printf(MSG_ERROR,
+			   "Unsupported parameter %s for SET_EDCCA", config);
+		return -1;
+	}
+	return os_snprintf(buf, buflen, "OK\n");
+}
+
+
+static int
+hostapd_ctrl_iface_get_edcca(struct hostapd_data *hapd, char *cmd, char *buf,
+			     size_t buflen)
+{
+	char *pos, *end;
+	u8 value[EDCCA_MAX_BW_NUM] = { 0 };
+
+	pos = buf;
+	end = buf + buflen;
+
+	if (os_strcmp(cmd, "enable") == 0) {
+		return os_snprintf(pos, end - pos, "Enable: %s\n",
+				   edcca_mode_str(hapd->iconf->edcca_enable));
+	} else if (os_strcmp(cmd, "compensation") == 0) {
+		return os_snprintf(pos, end - pos, "Compensation: %d\n",
+				  hapd->iconf->edcca_compensation);
+	} else if (os_strcmp(cmd, "threshold") == 0) {
+		if (hostapd_drv_get_edcca(hapd, EDCCA_CTRL_GET_THRES, &value) != 0)
+			return -1;
+		return os_snprintf(pos, end - pos,
+				   "Threshold BW20: 0x%x, BW40: 0x%x, BW80: 0x%x, BW160: 0x%x\n",
+				   value[0], value[1], value[2], value[3]);
+	} else {
+		wpa_printf(MSG_ERROR,
+			"Unsupported parameter %s for GET_EDCCA", cmd);
+		return -1;
+	}
+}
+
