+static int hostapd_parse_edcca_threshold(int **threshold, const char *val)
+{
+	const char *pos = val;
+	char *end;
+	int *list;
+	size_t i;
+	long value;
+
+	list = os_calloc(EDCCA_MAX_BW_NUM, sizeof(*list));
+	if (!list)
+		return -1;
+
+	for (i = 0; i < EDCCA_MAX_BW_NUM; i++) {
+		while (*pos == ' ' || *pos == '\t')
+			pos++;
+		if (!*pos)
+			goto fail;
+
+		value = strtol(pos, &end, 10);
+		if (end == pos || value < EDCCA_MIN_CONFIG_THRES ||
+		    value > EDCCA_MAX_CONFIG_THRES)
+			goto fail;
+
+		list[i] = value;
+		pos = end;
+	}
+
+	while (*pos == ' ' || *pos == '\t')
+		pos++;
+	if (*pos)
+		goto fail;
+
+	os_free(*threshold);
+	*threshold = list;
+	return 0;
+
+fail:
+	os_free(list);
+	return -1;
+}
