Subject: [PATCH] mtk: hostapd: fix vendor control error handling

Reject incomplete vendor dump responses instead of treating them as
successful and consuming uninitialized or stale values.  Also align the
wireless control attribute IDs with mt76, validate SET_MU input, restore
the previous MU setting on failure, and use a portable format for u64.

--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -4217,35 +4217,36 @@ static int
 hostapd_ctrl_iface_set_mu(struct hostapd_data *hapd, char *cmd,
 					 char *buf, size_t buflen)
 {
-	char *pos, *config, *value;
+	char *pos, *config, *value, *end;
+	long mu;
+	u8 old_mu;
+
 	config = cmd;
 	pos = os_strchr(config, ' ');
 	if (pos == NULL)
 		return -1;
 	*pos++ = '\0';
-
-	if(pos == NULL)
-		return -1;
 	value = pos;
 
-	if (os_strcmp(config, "onoff") == 0) {
-		int mu = atoi(value);
-		if (mu < 0 || mu > 15) {
-			wpa_printf(MSG_ERROR, "Invalid value for mu");
-			return -1;
-		}
-		hapd->iconf->mu_onoff = (u8) mu;
-	} else {
+	if (os_strcmp(config, "onoff") != 0) {
 		wpa_printf(MSG_ERROR,
 			"Unsupported parameter %s for SET_MU", config);
 		return -1;
 	}
 
-	if(hostapd_drv_mu_ctrl(hapd) == 0) {
-		return os_snprintf(buf, buflen, "OK\n");
-	} else {
+	mu = strtol(value, &end, 10);
+	if (value == end || *end != '\0' || mu < 0 || mu > 15) {
+		wpa_printf(MSG_ERROR, "Invalid value for mu");
 		return -1;
 	}
+
+	old_mu = hapd->iconf->mu_onoff;
+	hapd->iconf->mu_onoff = (u8) mu;
+	if (hostapd_drv_mu_ctrl(hapd) == 0)
+		return os_snprintf(buf, buflen, "OK\n");
+
+	hapd->iconf->mu_onoff = old_mu;
+	return -1;
 }
 
 
@@ -4253,7 +4254,7 @@ static int
 hostapd_ctrl_iface_get_mu(struct hostapd_data *hapd, char *buf,
 					 size_t buflen)
 {
-	u8 mu_onoff;
+	u8 mu_onoff = 0;
 	char *pos, *end;
 
 	pos = buf;
@@ -4305,8 +4306,8 @@ static int
 hostapd_ctrl_iface_get_amsdu(struct hostapd_data *hapd, char *buf,
 					 size_t buflen)
 {
-	u8 amsdu;
-	int ret;
+	u8 amsdu = 0;
+	int ret = -1;
 	char *pos, *end;
 
 	pos = buf;
@@ -4318,8 +4319,8 @@ hostapd_ctrl_iface_get_amsdu(struct host
 					hapd->iconf->amsdu);
 	}
 
-	if (os_snprintf_error(end - pos, ret))
-		return 0;
+	if (ret < 0 || os_snprintf_error(end - pos, ret))
+		return -1;
 
 	return ret;
 }
@@ -4329,11 +4330,6 @@ hostapd_ctrl_iface_get_bss_color(struct
 		size_t buflen)
 {
 	int ret;
-	char *pos, *end;
-	int i;
-
-	pos = buf;
-	end = buf + buflen;
 
 	if (hapd->iface->conf->he_op.he_bss_color_disabled)
 		ret = os_snprintf(buf, buflen, "BSS Color disabled\n");
@@ -4341,9 +4337,10 @@ hostapd_ctrl_iface_get_bss_color(struct
 		ret = os_snprintf(buf, buflen, "BSS Color=%u\n",
 				  hapd->iface->conf->he_op.he_bss_color);
 
-	pos += ret;
+	if (os_snprintf_error(buflen, ret))
+		return -1;
 
-	return pos - buf;
+	return ret;
 }
 
 
@@ -4356,15 +4353,17 @@ hostapd_ctrl_iface_get_aval_color_bmp(st
 	int i;
 	u64 aval_color_bmp = 0;
 
-	hostapd_drv_get_aval_bss_color_bmp(hapd, &aval_color_bmp);
+	if (hostapd_drv_get_aval_bss_color_bmp(hapd,
+						&aval_color_bmp) < 0)
+		return -1;
 	hapd->color_collision_bitmap = ~aval_color_bmp;
 
 	pos = buf;
 	end = buf + buflen;
 
 	ret = os_snprintf(buf, buflen,
-			"available color bitmap=0x%lx\n",
-			aval_color_bmp);
+			"available color bitmap=0x%llx\n",
+			(unsigned long long) aval_color_bmp);
 	if (os_snprintf_error(end - pos, ret))
 		return pos - buf;
 	pos += ret;
--- a/src/ap/ap_drv_ops.c
+++ b/src/ap/ap_drv_ops.c
@@ -1465,7 +1465,7 @@ int hostapd_drv_mu_ctrl(struct hostapd_d
 int hostapd_drv_mu_dump(struct hostapd_data *hapd, u8 *mu_onoff)
 {
 	if (!hapd->driver || !hapd->driver->mu_dump)
-		return 0;
+		return -EOPNOTSUPP;
 	return hapd->driver->mu_dump(hapd->drv_priv, mu_onoff);
 }
 
@@ -1490,7 +1490,7 @@ int hostapd_drv_ibf_ctrl(struct hostapd_
 int hostapd_drv_ibf_dump(struct hostapd_data *hapd, u8 *ibf_enable)
 {
 	if (!hapd->driver || !hapd->driver->ibf_dump)
-		return 0;
+		return -EOPNOTSUPP;
 	return hapd->driver->ibf_dump(hapd->drv_priv, ibf_enable);
 }
 
@@ -1504,7 +1504,7 @@ int hostapd_drv_amsdu_ctrl(struct hostap
 int hostapd_drv_amsdu_dump(struct hostapd_data *hapd, u8 *amsdu)
 {
 	if (!hapd->driver || !hapd->driver->amsdu_dump)
-		return 0;
+		return -EOPNOTSUPP;
 	return hapd->driver->amsdu_dump(hapd->drv_priv, amsdu);
 }
 
@@ -1512,7 +1512,7 @@ int hostapd_drv_get_aval_bss_color_bmp(s
 {
 	if (!hapd->driver || !hapd->driver->get_aval_color_bmp ||
 	    hapd->iface->conf->he_op.he_bss_color_disabled)
-		return 0;
+		return -EOPNOTSUPP;
 	return hapd->driver->get_aval_color_bmp(hapd->drv_priv, aval_color_bmp);
 }
 
