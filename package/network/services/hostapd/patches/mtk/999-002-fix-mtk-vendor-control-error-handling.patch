+	wpa_printf(MSG_DEBUG, "nla_get mu_onoff: %d\n", *data->value);
 
-	return 0;
+	return NL_SKIP;
 }
 
 static int nl80211_mu_dump(void *priv, u8 *mu_onoff)
@@ -15563,12 +15577,15 @@ static int nl80211_mu_dump(void *priv, u
 	struct wpa_driver_nl80211_data *drv = bss->drv;
 	struct nl_msg *msg;
 	struct nlattr *attr;
+	struct mtk_u8_dump_data data = {
+		.value = mu_onoff,
+	};
 	int ret;
 
