-	}
+	if (!attr)
+		goto fail;
 
 	nla_nest_end(msg, attr);
 
 	ret = send_and_recv_resp(drv, msg,
-		nl80211_get_aval_color_bmp_handler, aval_color_bmp);
+		nl80211_get_aval_color_bmp_handler, &data);
+	if (!ret && !data.valid)
+		ret = -EINVAL;
 
 	if (ret) {
 		wpa_printf(MSG_ERROR, "Failed to send BSS COLOR vendor cmd. ret=%d (%s) ",
 			   ret, strerror(-ret));
 	}
 	return ret;
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
 }
 
