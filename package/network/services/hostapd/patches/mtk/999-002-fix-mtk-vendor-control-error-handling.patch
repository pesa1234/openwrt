+	*data->value = nla_get_u64(attr);
+	data->valid = true;
 
-	return 0;
+	return NL_SKIP;
 }
 
 static int nl80211_get_aval_color_bmp(void *priv, u64 *aval_color_bmp)
@@ -15652,36 +15681,46 @@ static int nl80211_get_aval_color_bmp(vo
 	struct wpa_driver_nl80211_data *drv = bss->drv;
 	struct nl_msg *msg;
 	struct nlattr *attr;
+	struct mtk_u64_dump_data data = {
+		.value = aval_color_bmp,
+	};
 	int ret;
 
 	if (!drv->mtk_bss_color_vendor_cmd_avail) {
 		wpa_printf(MSG_INFO,
 			   "nl80211: Driver does not support BSS COLOR vendor cmd");
-		return 0;
+		return -EOPNOTSUPP;
 	}
 
-	if (!(msg = nl80211_drv_msg(drv, NLM_F_DUMP, NL80211_CMD_VENDOR)) ||
-	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, OUI_MTK) ||
+	msg = nl80211_drv_msg(drv, NLM_F_DUMP, NL80211_CMD_VENDOR);
+	if (!msg)
+		return -ENOBUFS;
+
+	if (nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, OUI_MTK) ||
 	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
 			MTK_NL80211_VENDOR_SUBCMD_BSS_COLOR_CTRL))
-		return -ENOBUFS;
